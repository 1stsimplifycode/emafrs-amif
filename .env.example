# Copy this file to .env and fill in the keys you have.
# The system degrades gracefully: any source whose key is missing is skipped
# (never mocked, never silently faked) and its absence is reported by the
# data-freshness/health panel.

# yfinance needs no key.

# https://console.cloud.google.com/apis/credentials (enable "YouTube Data API v3")
YOUTUBE_API_KEY=

# https://newsapi.org/register
NEWS_API_KEY=

# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# https://finnhub.io/register
FINNHUB_API_KEY=

# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional: SEC EDGAR requires no key but requires a descriptive User-Agent
# per SEC fair-access policy: "Sample Company Name AdminContact@sample.com"
SEC_EDGAR_USER_AGENT=EMAFRS-Research-Reconstruction you@example.com

# --- Database (production layer, filled in later phases) ---
DATABASE_URL=sqlite:///./data/emafrs.db

# --- App ---
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Scheduler (emafrs.mlops.scheduler) ---
# Real background job, started from the FastAPI app's lifespan: periodically refreshes
# data-source health and predictions instead of only updating on a user click. See
# scheduler.py's module docstring for the real quota math behind these defaults.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=21600          # 6 hours
SCHEDULER_TICKERS=SPY,QQQ,AAPL,MSFT,NVDA
SCHEDULER_REFRESH_DATA_HEALTH=true
SCHEDULER_REFRESH_PREDICTIONS=true
SCHEDULER_HEALTH_LIVE_PROBE=false         # true = real network probes every cycle (costs quota, notably YouTube search.list)
SCHEDULER_INCLUDE_TEXT=false              # true = each scheduled prediction also attempts a real YouTube+NewsAPI text fetch (costs quota)
